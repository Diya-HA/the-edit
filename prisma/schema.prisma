// The Edit — v1 schema.
//
// Cut down from the 18-entity model in docs/data-model-cards.html to the six
// tables v1 actually needs. What was dropped, and where it went:
//
//   CATEGORY       -> Product.category, a plain string. One table for a label.
//   COLOR          -> Product.color*, denormalised. The palette is a fixed set
//                     of design tokens, not user data; a table would only ever
//                     be read as a lookup.
//   PRICE_HISTORY  -> Product.wasPrice. v1 shows "this dropped from X", which
//                     is one prior number, not a series.
//   BOARD          -> Edit. Same entity in the product's own language.
//   BOARD_ITEM     -> SavedItem.
//   FOLLOW, PRICE_ALERT, NOTIFICATION, and everything in the "Curate & act"
//                     domain (CURATOR_BRIEF, CURATED_SET, CURATED_ITEM,
//                     INTERACTION, OUTBOUND_CLICK) are out of v1 entirely.
//
// The relationships that survive keep the cardinality the model specifies:
// a brand supplies many pieces, each piece is tagged to one aesthetic, a user
// keeps many edits, and edits meet products through SavedItem.
//
// WHY PRISMA IS PINNED TO EXACTLY 6.3.1 — do not bump without reading this.
//
// Two separate constraints, both set by the deploy template's Dockerfile,
// which runs `prisma migrate deploy` at container start with only these in
// the runtime image:
//
//     node_modules/prisma        node_modules/@prisma        prisma/
//
// 1. Not 7.x. Prisma 7 removed `url` from the schema — it has to live in
//    prisma.config.ts, which that Dockerfile never copies, and migrate deploy
//    hard-errors without it. Keeping the URL here is what makes the image work
//    untouched.
//
// 2. Not 6.4+. The CLI's dependency closure has to sit entirely under
//    node_modules/@prisma, because nothing else is copied. That holds up to
//    6.3.x. 6.4 added top-level `esbuild`, 6.5 added `@prisma/config` (which
//    pulls in `effect`, `c12`, `deepmerge-ts`, `empathic`), and 7.x adds
//    `mysql2` and `postgres`. Any of those and the container dies at startup
//    with MODULE_NOT_FOUND before it ever reaches the database — which is
//    exactly what happened on the first deploy.
//
// Pinned exact, not caret, so a stray `npm install` cannot reintroduce it.
// Bumping means either copying more into the image or forking the Dockerfile.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A shopper. Onboarding sets the aesthetic their feed opens on.
model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String
  /// Two letters for the Avatar component — "AL".
  initials    String   @db.VarChar(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activeAestheticId String?    @db.Uuid
  activeAesthetic   Aesthetic? @relation(fields: [activeAestheticId], references: [id], onDelete: SetNull)

  edits     Edit[]
  follows   Follow[]
  favourites FavouriteLook[]

  @@index([activeAestheticId])
  @@map("users")
}

/// A label you follow. Its new pieces surface first, and its price drops are
/// what the shelf is actually for. The data model's FOLLOW, added in turn 3
/// when the brands shelf became a real screen.
model Follow {
  userId     String   @db.Uuid
  brandId    String   @db.Uuid
  followedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
  @@index([brandId])
  @@map("follows")
}

/// A label whose pieces appear in the feed.
model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  /// A line for the brand shelf — "New linen just arrived".
  meta      String?
  /// Tint token carried by the shelf swatch, e.g. "--tint-rose".
  colorToken String  @default("--tint-cobalt")
  isPartner Boolean  @default(false)
  createdAt DateTime @default(now())

  products  Product[]
  followers Follow[]

  @@map("brands")
}

/// A named look — "Soft romance". Every product is tagged to exactly one.
model Aesthetic {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  /// The one-line description shown under the name in the deck.
  description String?
  /// Styled like a season — "Soft romance ’26".
  wordmark    String?
  createdAt   DateTime @default(now())

  products   Product[]
  users      User[]
  favourites FavouriteLook[]
  outfits    Outfit[]

  @@map("aesthetics")
}

/// Where a piece sits in a head-to-toe look.
///
/// `category` stays as the garment noun the brand uses — "overshirt", "mary
/// jane" — because that is what the placeholder label shows. This is the
/// canonical slot underneath it, so an assembler can insist on one top, one
/// bottom, one outer layer and so on across brands that all name things
/// differently. Nullable on purpose: a piece nobody has classified is left
/// out of an outfit rather than guessed into the wrong slot.
enum Slot {
  TOP
  BOTTOM
  OUTER
  SHOES
  BAG
  ACCESSORY
}

/// Where a row came from. Agent runs write AGENT; anything the seed puts
/// there is SEED, which is also how the app knows to label demo content.
enum Source {
  SEED
  AGENT
  HUMAN
}

/// An assembled outfit: several pieces from one aesthetic that work together,
/// saveable as a set rather than piece by piece.
///
/// This table is a write target for an agent, not just the seed. A
/// non-interactive run scores garments with .claude/skills/aesthetic-fit and
/// writes outfits here, and they appear in the app without anyone touching
/// the UI. Two consequences for the shape:
///
///   - `slug` is the idempotency key. A run that reassembles the same outfit
///     upserts it rather than duplicating, so the job is safe to repeat.
///   - `note` holds the skill's one-line reasoning in the product voice —
///     the sentence a shopper reads under the outfit. Same rules as a WHY
///     line: sentence case, under 20 words, no hype.
///
/// Write through `upsertOutfit` in prisma/outfits.ts, which both the seed and
/// the createOutfit server action use, so validation lives in one place.
model Outfit {
  id     String @id @default(uuid()) @db.Uuid
  slug   String @unique
  name   String
  /// The skill's one-line reasoning, product voice.
  note   String?
  source Source @default(SEED)

  aestheticId String    @db.Uuid
  aesthetic   Aesthetic @relation(fields: [aestheticId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OutfitItem[]

  @@index([aestheticId])
  @@map("outfits")
}

/// A piece inside an outfit, with the skill's verdict on why it is here.
model OutfitItem {
  outfitId  String @db.Uuid
  productId String @db.Uuid
  /// Order within the outfit.
  position  Int    @default(0)
  /// The aesthetic-fit score out of 100, when an agent placed the piece.
  score     Int?
  /// The piece's own WHY line within this outfit.
  note      String?

  outfit  Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([outfitId, productId])
  @@index([productId])
  @@map("outfit_items")
}

/// A look you starred. Starred looks sort first on the home strip, so home
/// leans toward what you keep coming back to. Turn 3's deck is what sets it.
model FavouriteLook {
  userId      String   @db.Uuid
  aestheticId String   @db.Uuid
  starredAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  aesthetic Aesthetic @relation(fields: [aestheticId], references: [id], onDelete: Cascade)

  @@id([userId, aestheticId])
  @@index([aestheticId])
  @@map("favourite_looks")
}

/// A real piece from a brand feed, tagged to one aesthetic and one tint.
model Product {
  id       String @id @default(uuid()) @db.Uuid
  /// Stable handle, so seeding can upsert rather than duplicate.
  slug     String @unique
  title    String
  /// Kept as a string rather than its own table — see the header note.
  category String
  /// Canonical slot in a head-to-toe look. Set at ingest by whatever scored
  /// the piece; two colourways of one style share a title, so the assembler
  /// dedupes on (brandId, title) and needs no separate style key.
  slot     Slot?

  price    Decimal  @db.Decimal(10, 2)
  /// Prior price. Its presence is what draws the drop badge.
  wasPrice Decimal? @db.Decimal(10, 2)

  /// Colour, in two parts.
  ///
  /// colorHex is the tone of the actual cloth and fills the placeholder — it
  /// is content, the stand-in for photography, so it lives here rather than
  /// as a token. colorToken/colorName are the palette *family* it groups
  /// into (`--fabric-sage`, "Sage"), which is what the filter row offers and
  /// what the swatch on a colour dot is painted with.
  colorName  String
  colorToken String
  colorHex   String @db.Char(7)

  /// One editorial line, serif italic under a hero card.
  line     String?
  /// Why this piece, for you — the rationale the detail screen shows after
  /// the line. The data model's CURATED_ITEM.rationale, denormalised onto
  /// the product until curated sets exist.
  why      String?
  imageUrl String?
  /// Where the affiliate click goes.
  productUrl String?
  inStock  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandId String @db.Uuid
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  aestheticId String    @db.Uuid
  aesthetic   Aesthetic @relation(fields: [aestheticId], references: [id], onDelete: Restrict)

  /// Position in the trending row. Seeded demo data — with one shopper there
  /// is no real popularity signal, so the app labels the row as a sample
  /// rather than presenting this as a measured metric.
  trendingRank Int?

  savedItems  SavedItem[]
  outfitItems OutfitItem[]

  @@index([brandId])
  @@index([aestheticId])
  @@index([colorToken])
  @@index([slot])
  @@map("products")
}

/// A user's saved collection — the data model's BOARD, in the product's
/// own language.
model Edit {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  /// "Growing since March".
  note       String?
  shareToken String?  @unique
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items SavedItem[]

  @@unique([userId, name])
  @@index([userId])
  @@map("edits")
}

/// A piece saved into an edit. The join between Edit and Product.
model SavedItem {
  id      String   @id @default(uuid()) @db.Uuid
  addedAt DateTime @default(now())

  editId String @db.Uuid
  edit   Edit   @relation(fields: [editId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// A piece lands in a given edit once.
  @@unique([editId, productId])
  @@index([editId])
  @@index([productId])
  @@map("saved_items")
}
